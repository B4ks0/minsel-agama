  "relationships": [
    {
      "id": "rel_kecamatan_gereja",
      "name": "Kecamatan to Gereja",
      "type": "One-to-Many",
      "description": "Satu kecamatan memiliki banyak gereja",
      "from": {
        "entity": "kecamatan",
        "key": "nama"
      },
      "to": {
        "entity": "gereja",
        "key": "kecamatan"
      },
      "cardinality": "1:N"
    },
    {
      "id": "rel_kecamatan_masjid",
      "name": "Kecamatan to Masjid",
      "type": "One-to-Many",
      "description": "Satu kecamatan (melalui wilayah_kua) memiliki banyak masjid",
      "from": {
        "entity": "kecamatan",
        "key": "nama"
      },
      "to": {
        "entity": "masjid_bkm",
        "key": "wilayah_kua"
      },
      "cardinality": "1:N"
    }
  ],
  "views": [
    {
      "name": "v_rekap_gereja_per_kecamatan",
      "description": "View untuk rekap data gereja per kecamatan",
      "query": "SELECT kecamatan, COUNT(*) AS jumlah_gereja, SUM(jumlah_umat_l) AS total_umat_laki, SUM(jumlah_umat_p) AS total_umat_perempuan, SUM(jumlah_umat) AS total_umat, SUM(jumlah_pdt) AS total_pendeta, SUM(jumlah_pdm) AS total_pdm FROM gereja GROUP BY kecamatan ORDER BY kecamatan",
      "columns": [
        {
          "name": "kecamatan",
          "type": "VARCHAR(100)",
          "description": "Nama kecamatan"
        },
        {
          "name": "jumlah_gereja",
          "type": "INT",
          "description": "Jumlah gereja di kecamatan tersebut"
        },
        {
          "name": "total_umat_laki",
          "type": "BIGINT",
          "description": "Total umat laki-laki"
        },
        {
          "name": "total_umat_perempuan",
          "type": "BIGINT",
          "description": "Total umat perempuan"
        },
        {
          "name": "total_umat",
          "type": "BIGINT",
          "description": "Total umat keseluruhan"
        },
        {
          "name": "total_pendeta",
          "type": "BIGINT",
          "description": "Total pendeta"
        },
        {
          "name": "total_pdm",
          "type": "BIGINT",
          "description": "Total pendeta muda/pekerja"
        }
      ]
    },
    {
      "name": "v_rekap_masjid_per_kua",
      "description": "View untuk rekap data masjid per KUA",
      "query": "SELECT wilayah_kua, COUNT(*) AS jumlah_masjid, SUM(ada_musholla) AS jumlah_musholla FROM masjid_bkm GROUP BY wilayah_kua ORDER BY wilayah_kua",
      "columns": [
        {
          "name": "wilayah_kua",
          "type": "VARCHAR(100)",
          "description": "Wilayah KUA"
        },
        {
          "name": "jumlah_masjid",
          "type": "INT",
          "description": "Jumlah masjid di wilayah KUA tersebut"
        },
        {
          "name": "jumlah_musholla",
          "type": "BIGINT",
          "description": "Jumlah mushollah"
        }
      ]
    }
